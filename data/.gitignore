# Never commit raw data, derived data or secrets.
raw/*
!raw/delete_this.txt
derived/
graph/

# Pipeline output: rebuild it by rerunning the scripts. The clauses quote the order texts in raw/, so they stay out too.
demand/
concerns/
rules/
decide/
.env
.env.*

# Local tool output
__pycache__/
.pytest_cache/
.ruff_cache/
